# Copy to .env and adjust:   cp .env.example .env
# `make` and `docker compose` both read .env automatically. .env is git-ignored: keep local
# paths, internal hostnames and registry addresses there, never in tracked files.

# ---- Backend (make dev / make run, without Docker) -----------------------------------------
# Listen address. Port 80 is never used; production maps its own host port to 8080.
BIND_ADDR=127.0.0.1:8080
# SQLite database file, and its size cap in MiB (writes beyond it fail cleanly).
DATABASE_URL=./sqlite.db
DATABASE_MAX_MB=256
# Built frontend served by the backend (make build creates it).
STATIC_DIR=web/dist
# PEM CA bundle that signed your NATS server certificates. Leave empty for public CAs or no TLS.
NATS_CA_FILE=
# Log filter (e.g. info, debug, nats_webui=debug,info) and format (text or json).
RUST_LOG=info
LOG_FORMAT=text

# ---- Docker compose (make up) -----------------------------------------------------------------
# Host path of the NATS CA certificate; mounted read-only into the container.
NATS_CA_HOST_PATH=
# Host port for the UI (bound to 127.0.0.1).
WEBUI_HOST_PORT=8080
# Image target: debug (with network/debug tools) or runtime (what production runs).
WEBUI_TARGET=debug
# Resource limits.
WEBUI_CPUS=1.0
WEBUI_MEM=256m
WEBUI_PIDS=256
# Database size cap in the container (MiB). With the read-only root filesystem, a 64 MB /tmp
# and rotated logs, this bounds the container's disk use.
WEBUI_DB_MAX_MB=256

# ---- Image build and push (make docker-build / make docker-push) ------------------------------
# Private registry, e.g. registry.example.internal:5000. Required for docker-push.
REGISTRY=
IMAGE=nats-webui
# Image tag; defaults to `git describe`.
# TAG=

# ---- Security scan (make scan) -----------------------------------------------------------------
# Public Semgrep CE + Trivy Docker images, pinned in scripts/security-scan.sh (same as CI).
# Override SEMGREP_IMAGE / TRIVY_IMAGE only to test a scanner upgrade.
# warn (report only) or enforce (fail on blocking findings).
SCAN_MODE=warn
